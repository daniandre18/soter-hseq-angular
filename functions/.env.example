# Copiar a .env.local para el Functions Emulator (nunca commitear valores reales).
# En producción, configurar con: firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=

# Par de claves VAPID para Web Push (generar con: npx web-push generate-vapid-keys).
# La pública también vive en apps/web/src/environments/*.ts (no es secreta).
# En producción, configurar ambas con:
#   firebase functions:secrets:set VAPID_PUBLIC_KEY
#   firebase functions:secrets:set VAPID_PRIVATE_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
