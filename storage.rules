rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Todo acceso a Storage pasa por Cloud Functions con el Admin SDK
    // (`uploadEvidence`, `closeOrder`), que no evalúan estas reglas y
    // validan rol/asignación/estado de la orden leyendo Firestore
    // directo (ver el comentario junto a `buildDownloadUrl` en
    // functions/src/index.ts). La lectura de archivos ya subidos usa las
    // URLs con token (`downloadUrl`/`pdfUrl`) que esas funciones guardan
    // en Firestore al momento de subir, no una llamada al SDK de cliente
    // contra Storage — así que el cliente nunca necesita, ni debe tener,
    // acceso directo de lectura o escritura acá.
    //
    // La razón de este diseño (y no `firestore.get()` dentro de estas
    // reglas, como en un principio) es que la lectura cruzada
    // Storage→Firestore no es confiable en este proyecto: falla incluso
    // con un `firestore.exists()` mínimo sobre un documento que sí
    // existe, verificado a mano contra producción.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
