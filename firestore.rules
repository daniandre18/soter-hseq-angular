rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentRole() {
      return currentUserDoc().data.role;
    }

    function hasRole(roles) {
      return isSignedIn() && currentRole() in roles;
    }

    function isAdmin() {
      return hasRole(['ADMIN']);
    }

    function currentClientId() {
      return currentUserDoc().data.clientId;
    }

    function viewerOwnsClient(clientId) {
      return hasRole(['VIEWER']) && currentClientId() == clientId;
    }

    function orderData(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId)).data;
    }

    function quoteData(quoteId) {
      return get(/databases/$(database)/documents/quotes/$(quoteId)).data;
    }

    function canReadOrder(orderId) {
      return hasRole(['ADMIN', 'COORDINATOR', 'COMMERCIAL'])
             || (hasRole(['TECHNICIAN'])
                 && request.auth.uid in orderData(orderId).assignedTechnicianIds)
             || viewerOwnsClient(orderData(orderId).clientId);
    }

    // Un usuario no puede cambiar su propio rol ni el de otros desde el frontend.
    match /users/{userId} {
      // El cliente solo necesita su propio perfil; los usuarios internos sí
      // resuelven nombres/técnicos para la operación y pueden listar usuarios.
      allow read: if hasRole(['ADMIN', 'COMMERCIAL', 'COORDINATOR', 'TECHNICIAN'])
                  || (hasRole(['VIEWER']) && request.auth.uid == userId);
      allow create: if false; // los usuarios se crean desde Cloud Functions
      // Un usuario no puede cambiar su propio rol NI su propio estado (p.
      // ej. reactivarse tras ser desactivado) — antes solo se protegía el
      // rol, dejando `status` editable por el propio usuario sin querer.
      allow update: if (isAdmin() && request.resource.data.role == resource.data.role)
                    || (isSignedIn() && request.auth.uid == userId
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.status == resource.data.status);
      allow delete: if false; // se eliminan desde la Cloud Function `deleteUser` (borra Auth + Firestore juntos)
    }

    match /clients/{clientId} {
      allow read: if hasRole(['ADMIN', 'COMMERCIAL', 'COORDINATOR'])
                  || viewerOwnsClient(clientId);
      allow create, update: if hasRole(['ADMIN', 'COMMERCIAL']);
      // Solo ADMIN, y solo un aviso en la UI (no un bloqueo aquí) de que
      // las cotizaciones/órdenes ya creadas conservan `clientBusinessName`
      // denormalizado — no se rompen visualmente aunque el cliente se borre.
      allow delete: if isAdmin();

      match /contacts/{contactId} {
        allow read: if hasRole(['ADMIN', 'COMMERCIAL', 'COORDINATOR'])
                    || viewerOwnsClient(clientId);
        allow write: if hasRole(['ADMIN', 'COMMERCIAL']);
      }

      match /sites/{siteId} {
        allow read: if hasRole(['ADMIN', 'COMMERCIAL', 'COORDINATOR'])
                    || viewerOwnsClient(clientId);
        allow write: if hasRole(['ADMIN', 'COMMERCIAL']);
      }
    }

    // Catálogo administrable de etiquetas de cliente (mismo criterio de
    // acceso que `clients`: quien puede editar un cliente puede gestionar
    // el catálogo). Sin "historial" propio que proteger — a diferencia de
    // `clients`, sí se permite `delete` a los mismos roles que crean.
    match /clientTags/{tagId} {
      allow read: if hasRole(['ADMIN', 'COMMERCIAL', 'COORDINATOR']);
      allow create, update, delete: if hasRole(['ADMIN', 'COMMERCIAL']);
    }

    match /services/{serviceId} {
      // Catálogo de servicios: se selecciona al armar una cotización, así
      // que el mismo alcance de roles que ya lee/escribe cotizaciones.
      // A diferencia de clients/quotes/orders, sí se permite `delete` real
      // (§29 no define retención de historial para esta colección, y un
      // ítem de cotización ya guarda `description`/`unitPrice` por su
      // cuenta al crearse, así que borrar el servicio del catálogo no deja
      // cotizaciones existentes con datos huérfanos).
      allow read: if hasRole(['ADMIN', 'COMMERCIAL', 'COORDINATOR']);
      allow create, update, delete: if hasRole(['ADMIN', 'COMMERCIAL']);
    }

    // Catálogo administrable de categorías de servicio — mismo criterio de
    // acceso que `services` (quien lo lee/edita puede gestionar categorías).
    match /serviceCategories/{categoryId} {
      allow read: if hasRole(['ADMIN', 'COMMERCIAL', 'COORDINATOR']);
      allow create, update, delete: if hasRole(['ADMIN', 'COMMERCIAL']);
    }

    match /quotes/{quoteId} {
      allow read: if hasRole(['ADMIN', 'COMMERCIAL', 'COORDINATOR'])
                  || viewerOwnsClient(resource.data.clientId);
      allow create: if hasRole(['ADMIN', 'COMMERCIAL']);
      // Los campos comerciales solo se pueden editar mientras sigue en
      // borrador. Después de enviarla, únicamente se permiten cambios de
      // estado/conversión junto con sus metadatos de actualización.
      allow update: if hasRole(['ADMIN', 'COMMERCIAL'])
                    && (resource.data.status == 'DRAFT'
                        || request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'orderIds', 'updatedAt', 'updatedBy']));
      allow delete: if hasRole(['ADMIN', 'COMMERCIAL']) && resource.data.status == 'DRAFT';

      match /items/{itemId} {
        allow read: if hasRole(['ADMIN', 'COMMERCIAL', 'COORDINATOR'])
                    || viewerOwnsClient(quoteData(quoteId).clientId);
        allow create, update: if hasRole(['ADMIN', 'COMMERCIAL']);
        allow delete: if hasRole(['ADMIN', 'COMMERCIAL'])
                      && quoteData(quoteId).status == 'DRAFT';
      }
    }

    match /orders/{orderId} {
      // COMMERCIAL incluido: CLAUDE.md §3.2 permite "consultar las órdenes
      // asociadas a sus clientes"; sin una relación cliente↔comercial
      // modelada todavía, se concede lectura general para el MVP.
      allow read: if isAdmin()
                   || hasRole(['COORDINATOR', 'COMMERCIAL'])
                   || (hasRole(['TECHNICIAN']) && request.auth.uid in resource.data.assignedTechnicianIds)
                   || viewerOwnsClient(resource.data.clientId);
      // COMMERCIAL también puede convertir una cotización aprobada en
      // orden (CLAUDE.md §3.2), lo que crea el documento de la orden.
      allow create: if hasRole(['ADMIN', 'COORDINATOR', 'COMMERCIAL']);
      // Una orden cerrada es de solo lectura salvo una acción explícita de
      // administrador auditada aparte (CLAUDE.md §10.2); COORDINATOR y
      // TECHNICIAN no pueden modificarla una vez CLOSED.
      // TECHNICIAN además queda limitado a los campos que su propio flujo de
      // campo necesita tocar (CLAUDE.md §11.4/§3.4): `status` (iniciar/enviar
      // a revisión, `OrdersService.updateStatus`), `progress`
      // (`updateProgress`), `actualStart`/`actualEnd`, que `updateStatus`
      // fija junto con el cambio de estado, y `evidenceCount` (el batch de
      // `OrdersService.uploadEvidence` lo incrementa junto con el documento
      // de evidencia; sin este campo en la lista, ese batch entero fallaba
      // y el técnico nunca podía subir evidencias). Reasignar técnicos o
      // reprogramar fechas sigue siendo exclusivo de COORDINATOR/ADMIN.
      allow update: if isAdmin()
                     || (hasRole(['COORDINATOR']) && resource.data.status != 'CLOSED')
                     || (hasRole(['TECHNICIAN'])
                         && request.auth.uid in resource.data.assignedTechnicianIds
                         && resource.data.status != 'CLOSED'
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly([
                                'status', 'progress', 'actualStart', 'actualEnd',
                                'evidenceCount', 'updatedAt', 'updatedBy'
                              ]));
      // Solo se puede eliminar en `DRAFT` (nada de campo/evidencia/actas
      // asociadas todavía) y solo admin: si la orden viene de una
      // cotización convertida, borrarla también revierte `quotes/{id}` a
      // `APPROVED` (ver `OrdersService.deleteOrder`), y `quotes` solo
      // admite `update` de ADMIN/COMMERCIAL — permitirlo a COORDINATOR aquí
      // rompería ese batch a mitad de camino.
      allow delete: if isAdmin() && resource.data.status == 'DRAFT';

      match /notes/{noteId} {
        allow read: if canReadOrder(orderId);
        allow create: if hasRole(['ADMIN', 'COORDINATOR', 'TECHNICIAN']) && orderData(orderId).status != 'CLOSED';
        allow update, delete: if false;
      }

      match /evidence/{evidenceId} {
        allow read: if canReadOrder(orderId);
        allow create: if hasRole(['ADMIN', 'COORDINATOR', 'TECHNICIAN']) && orderData(orderId).status != 'CLOSED';
        allow update: if hasRole(['ADMIN', 'COORDINATOR']);
        allow delete: if false;
      }

      match /events/{eventId} {
        allow read: if canReadOrder(orderId);
        allow write: if false; // la bitácora solo la escribe el backend
      }
    }

    match /closingActs/{actId} {
      allow read: if canReadOrder(resource.data.orderId);
      // El documento inicial lo crea `generateClosingAct` con el Admin SDK
      // (ignora estas reglas); `create` de cliente queda para uso futuro,
      // ya con la misma condición de rol. `FINAL` es inmutable: una vez
      // cerrada la orden, ni admin ni coordinador pueden reescribir el acta
      // desde el cliente (CLAUDE.md §23.7) — solo `closeOrder` la marca así.
      allow create: if hasRole(['ADMIN', 'COORDINATOR']);
      allow update: if hasRole(['ADMIN', 'COORDINATOR']) && resource.data.status != 'FINAL';
      allow delete: if false;
    }

    match /auditEvents/{eventId} {
      allow read: if hasRole(['ADMIN', 'COORDINATOR']);
      allow write: if false; // solo el backend escribe bitácora de auditoría
    }

    // Inbox de notificaciones del header (ADMIN/COORDINATOR): un documento
    // por evento. `readBy` y `dismissedBy` guardan el estado personal sin
    // borrar el documento compartido. El cliente solo puede agregar su uid
    // a esos arrays, sin tocar otros campos ni quitar entradas existentes.
    match /notifications/{notificationId} {
      allow read: if hasRole(['ADMIN', 'COORDINATOR']);
      allow create: if false;
      allow update: if hasRole(['ADMIN', 'COORDINATOR'])
                     && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['readBy', 'dismissedBy'])
                     && request.resource.data.get('readBy', [])
                          .hasAll(resource.data.get('readBy', []))
                     && request.resource.data.get('dismissedBy', [])
                          .hasAll(resource.data.get('dismissedBy', []))
                     && request.resource.data.get('readBy', [])
                          .removeAll(resource.data.get('readBy', [])).hasOnly([request.auth.uid])
                     && request.resource.data.get('dismissedBy', [])
                          .removeAll(resource.data.get('dismissedBy', [])).hasOnly([request.auth.uid]);
      allow delete: if false;
    }

    // Documento único `settings/general` (nombre de empresa, logo, tema del
    // sidebar) — todo usuario autenticado lo lee (el sidebar lo necesita
    // para cualquier rol), solo ADMIN lo escribe (CLAUDE.md §3.1
    // "Configurar parámetros básicos"). El logo en sí se sube por Cloud
    // Function (`uploadLogo`, Admin SDK) porque Storage exige el mismo
    // patrón que `uploadEvidence`; este documento solo guarda su URL.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Denegar por defecto cualquier otra ruta (mismo criterio que storage.rules).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
