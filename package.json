{
  "name": "soter-hseq-angular",
  "version": "0.0.0",
  "private": true,
  "description": "Tooling de repo (Firebase CLI, emuladores, seeds) para el MVP SOTER HSEQ",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-soter-hseq",
    "emulators:export": "firebase emulators:start --project demo-soter-hseq --export-on-exit=./.emulator-data --import=./.emulator-data",
    "seed": "npm --prefix scripts run seed",
    "seed:catalog": "npm --prefix scripts run seed:catalog",
    "seed:clients": "npm --prefix scripts run seed:clients",
    "seed:clients:production": "npm --prefix scripts run seed:clients:production",
    "test:rules": "firebase emulators:exec --config firebase.test.json --project demo-soter-hseq --only firestore \"node --test tests/firestore-rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.17.1",
    "firebase-tools": "^15.25.0"
  }
}
